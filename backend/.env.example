# Copia este archivo a .env para desarrollo local. Nunca subas .env al repo.
NODE_ENV=development
APP_ENV=dev
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# Coincide con docker-compose.yml (solo desarrollo local).
DATABASE_URL=postgresql://sentia:sentia_dev@localhost:5432/sentia?schema=public

# Orígenes permitidos para CORS, separados por coma (portal web, Etapa 4+). Vacío = ninguno.
CORS_ORIGINS=

# Secretos: genera valores propios con
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   (JWT, sal)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      (llave de cifrado)
JWT_ACCESS_SECRET=
IP_HASH_SALT=
FIELD_ENCRYPTION_KEY=

# Correo: Mailpit en docker-compose (bandeja en http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=SentIA <no-reply@sentia.invalid>
